{
    "name": "article-threader",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:extension": "npm-watch",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "build:extension": "BUILD_EXTENSION=1 next build && npm run lint:build",
        "lint:build": "node scripts/prepare-extension.cjs",
        "package": "npm run build:extension && zip -r packages/$(date -u +\"%Y-%m-%dT%H:%M:%SZ\").zip out"
    },
    "dependencies": {
        "@emotion/react": "^11.10.5",
        "@extractus/article-extractor": "^7.2.8-rc1",
        "@theme-ui/presets": "^0.15.4",
        "@types/node": "18.11.18",
        "@types/react": "18.0.26",
        "@types/react-dom": "18.0.10",
        "@upstash/redis": "^1.19.3",
        "eslint": "8.57.1",
        "eslint-config-next": "15.5.28",
        "googleapis": "^122.0.0",
        "isomorphic-unfetch": "^4.0.2",
        "next": "15.5.28",
        "next-plausible": "3.12.5",
        "openai": "^3.1.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-query": "^3.39.2",
        "string-strip-html": "^13.0.6",
        "theme-ui": "^0.15.4",
        "typescript": "4.9.4",
        "sharp": "0.35.5"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.212",
        "npm-watch": "^0.11.0"
    },
    "watch": {
        "build:extension": {
            "patterns": [
                ".",
                "styles/**",
                "pages/**",
                "public/**"
            ],
            "ignore": [
                "out",
                "node_moduels",
                ".next"
            ],
            "extensions": [
                "js",
                "json",
                "lock",
                "tsx",
                "ts"
            ]
        }
    },
    "packageManager": "npm@11.6.2"
}
